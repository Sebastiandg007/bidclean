{
  "enabled": true,
  "name": "Validate & Fix Lint Before Push",
  "description": "Runs ESLint with --fix across the entire monorepo (apps/mobile + services/api) before any git push. Automatically fixes what it can, amends the commit if fixes were applied, and blocks the push only if unfixable errors remain.",
  "version": "3",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      ".*git\\s+push.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "This shell command contains 'git push'. Before proceeding, you MUST validate the entire monorepo passes lint. Follow these steps IN ORDER:\n\n1. Run 'npx eslint --fix apps/mobile/src services/api/src --ext .ts,.tsx --max-warnings 0' from the project root.\n2. If eslint --fix modified files (check git status), stage the fixes with 'git add -A' and amend the last commit with 'git commit --amend --no-edit'.\n3. Run 'npx eslint apps/mobile/src services/api/src --ext .ts,.tsx --max-warnings 0' again to verify no remaining errors.\n4. If step 3 still fails, manually fix the remaining errors (they are not auto-fixable), stage, and amend the commit.\n5. Only proceed with the git push when lint passes with zero errors.\n\nDo NOT skip this process. Do NOT push if lint fails."
  }
}
