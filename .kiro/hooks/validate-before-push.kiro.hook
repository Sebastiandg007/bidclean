{
  "enabled": true,
  "name": "Validate Lint & Types Before Push",
  "description": "Runs ESLint with --fix and tsc --noEmit across the entire monorepo before any git push. Automatically fixes lint issues, amends the commit if fixes were applied, and blocks the push only if unfixable errors remain.",
  "version": "4",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      ".*git\\s+push.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "This shell command contains 'git push'. Before proceeding, you MUST validate the entire monorepo passes lint AND type-check. Follow these steps IN ORDER:\n\n1. Run 'npx eslint --fix apps/mobile/src services/api/src --ext .ts,.tsx --max-warnings 0' from the project root.\n2. Run 'npx tsc --noEmit --project apps/mobile/tsconfig.json' from the project root.\n3. If eslint --fix modified files (check git status), stage the fixes with 'git add -A' and amend the last commit with 'git commit --amend --no-edit'.\n4. If either check failed and could not be auto-fixed, manually fix the remaining errors, stage, and amend the commit.\n5. Only proceed with the git push when BOTH lint and tsc pass with zero errors.\n\nDo NOT skip this process. Do NOT push if either check fails."
  }
}
