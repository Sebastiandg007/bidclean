{
  "enabled": true,
  "name": "Validate Lint & Types Before Push",
  "description": "Before executing git push, runs lint and typecheck locally to catch issues that would fail CI. Prevents pushing code that breaks the pipeline.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the command being executed contains 'git push', you MUST first run lint and typecheck to validate the code passes CI checks. Run these commands in order: 1) 'npm run lint' from the workspace root, 2) 'npm run typecheck' from the workspace root. If ANY of these commands fail (non-zero exit code), DO NOT proceed with the push. Instead, fix the lint/typecheck errors first, then retry the push. If all checks pass, proceed with the original git push command. If the command does NOT contain 'git push', ignore this instruction and allow the command to proceed."
  }
}