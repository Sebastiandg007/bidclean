# ==============================================================================
# BidClean — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql://bidclean:bidclean_local@localhost:5432/bidclean
POSTGRES_PASSWORD=bidclean_local

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION=60
RATE_LIMIT_BIOMETRIC_POINTS=5
RATE_LIMIT_BIOMETRIC_DURATION=60
RATE_LIMIT_GENERAL_POINTS=30
RATE_LIMIT_GENERAL_DURATION=60

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=bidclean
MINIO_ROOT_PASSWORD=bidclean_local
MINIO_ENDPOINT=http://localhost:9000

# --- Keycloak (Auth) ---

# Admin API credentials (used by NestJS to create users, revoke sessions)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_URL=http://localhost:8080

# Realm and client configuration
KEYCLOAK_REALM=bidclean
KEYCLOAK_CLIENT_ID=bidclean-app
KEYCLOAK_CLIENT_SECRET=change_me_in_production

# JWT validation
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/bidclean/protocol/openid-connect/certs

# OAuth endpoints
KEYCLOAK_TOKEN_ENDPOINT=http://localhost:8080/realms/bidclean/protocol/openid-connect/token
KEYCLOAK_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/bidclean/protocol/openid-connect/auth

# OAuth callback (where Keycloak redirects after login on web/API)
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# Mobile OAuth configuration (deep link scheme for PKCE redirect)
KEYCLOAK_MOBILE_REDIRECT_SCHEME=bidclean
KEYCLOAK_MOBILE_REDIRECT_URI=bidclean://auth/callback

# Email verification sync (Keycloak → BidClean DB)
KEYCLOAK_EMAIL_SYNC_INTERVAL_MS=30000
KEYCLOAK_EMAIL_SYNC_BATCH_SIZE=50

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- RevenueCat ---
REVENUECAT_API_KEY_APPLE=appl_...
REVENUECAT_API_KEY_GOOGLE=goog_...
REVENUECAT_API_V2_SECRET=sk_...
REVENUECAT_API_KEY=sk_...
REVENUECAT_PROJECT_ID=proj_...
REVENUECAT_API_URL=https://api.revenuecat.com/v1

# --- OneSignal ---
ONESIGNAL_APP_ID=...
ONESIGNAL_API_KEY=...

# --- KYC (Know Your Customer) ---

# AI Service (FastAPI)
KYC_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_AUTH_TOKEN=change_me_in_production

# Verification thresholds (scores 0.0–1.0)
KYC_OCR_CONFIDENCE_THRESHOLD=0.85
KYC_FACE_SIMILARITY_THRESHOLD=0.80
KYC_LIVENESS_THRESHOLD=0.90

# Retry & processing
KYC_MAX_ATTEMPTS=3
KYC_MAX_RETRY_ATTEMPTS=3
KYC_PROCESSING_MAX_RETRIES=3
KYC_PROCESSING_BACKOFF_MS=5000
KYC_PROCESSING_TIMEOUT_MS=60000

# Storage
KYC_MINIO_BUCKET=kyc-documents
KYC_RETENTION_DAYS=90
KYC_CLEANUP_BATCH_SIZE=50
KYC_MAX_FILE_SIZE_MB=10

# Image quality
KYC_MIN_IMAGE_WIDTH=800
KYC_MIN_IMAGE_HEIGHT=600

# Rate limiting
KYC_RATE_LIMIT_PER_HOUR=10

# Concurrency
KYC_MAX_CONCURRENT=5

# --- Profile ---

# Storage
MINIO_PROFILE_PHOTOS_BUCKET=profile-photos

# Photo constraints
PROFILE_PHOTO_MAX_SIZE_MB=5
PROFILE_PHOTO_MAX_DIMENSION_PX=1024
PROFILE_PHOTO_URL_EXPIRY_SECONDS=3600

# Portfolio
PROFILE_MAX_PORTFOLIO_PHOTOS=20

# Upload & rate limiting
PROFILE_UPLOAD_TIMEOUT_MS=30000
PROFILE_RATE_LIMIT_PER_MINUTE=60

# Field validation
PROFILE_NAME_MAX_LENGTH=100
PROFILE_BIO_MAX_LENGTH=500

# Account deletion
PROFILE_DELETE_CONFIRMATION_WORD=DELETE
PROFILE_DELETION_MAX_RETRIES=5

# Profile completeness weights (must sum to 100 per role)
PROFILE_COMPLETENESS_WEIGHTS_HOST=name:25,photo:25,business_name:20,payment_method:15,first_property:15
PROFILE_COMPLETENESS_WEIGHTS_CLEANER=name:15,photo:15,specialties:15,work_zone:15,availability:10,portfolio:10,kyc:10,bio:10

# Keycloak webhook (email sync)
KEYCLOAK_WEBHOOK_SECRET=change_me_in_production

# --- Property Management ---

# Storage
MINIO_PROPERTY_PHOTOS_BUCKET=property-photos

# Photo constraints
PROPERTY_PHOTO_MAX_SIZE_MB=10
PROPERTY_PHOTO_MAX_DIMENSION_PX=2048
PROPERTY_PHOTO_URL_EXPIRY_SECONDS=3600
PROPERTY_MAX_PHOTOS=10

# Upload & rate limiting
PROPERTY_UPLOAD_TIMEOUT_MS=60000
PROPERTY_RATE_LIMIT_PER_MINUTE=60

# Field validation limits
PROPERTY_MAX_SQM=10000
PROPERTY_MAX_BEDROOMS=50
PROPERTY_MAX_BATHROOMS=20
PROPERTY_MAX_CHECKLIST_ITEMS=30
PROPERTY_MAX_REQUIREMENTS=20

# Geocoding (Mapbox)
MAPBOX_ACCESS_TOKEN=pk.ey...
PROPERTY_GEOCODING_RATE_LIMIT=30

# --- Offer Publishing ---

# Commission rates (basis points: 1 bp = 0.01%)
OFFER_HOST_FEE_RATE=1000
OFFER_CLEANER_RATE=300

# Radius expansion configuration (meters / milliseconds)
OFFER_INITIAL_RADIUS=3000
OFFER_EXPANSION_STEP=2000
OFFER_MAX_RADIUS=25000
OFFER_EXPANSION_INTERVAL_MS=300000
OFFER_FINAL_WAIT_MS=600000

# Tier delivery timing (milliseconds)
OFFER_FAVORITES_WINDOW_MS=180000
OFFER_PRO_FREE_DELAY_MS=120000

# Validation bounds (minutes)
OFFER_MIN_LEAD_MINUTES=60
OFFER_MIN_DURATION_MINUTES=30
OFFER_MAX_DURATION_MINUTES=480

# BullMQ job configuration
OFFER_MAX_RETRIES=3
OFFER_BACKOFF_DELAY_MS=5000

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# --- LibreTranslate ---
LIBRE_TRANSLATE_URL=http://localhost:5000

# --- Centrifugo ---
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=CHANGE_ME_IN_PRODUCTION
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION

# --- API ---
PORT=3000
NODE_ENV=development

# --- Default User Settings (used for social login users without explicit country/language) ---
DEFAULT_USER_COUNTRY=US
DEFAULT_USER_LANGUAGE=en
