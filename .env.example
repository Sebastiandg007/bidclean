# ==============================================================================
# BidClean — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql://bidclean:bidclean_local@localhost:5432/bidclean
POSTGRES_PASSWORD=bidclean_local

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION=60
RATE_LIMIT_BIOMETRIC_POINTS=5
RATE_LIMIT_BIOMETRIC_DURATION=60
RATE_LIMIT_GENERAL_POINTS=30
RATE_LIMIT_GENERAL_DURATION=60

# --- MinIO (Object Storage) ---
# required (validated at startup)
MINIO_ROOT_USER=bidclean
# required (validated at startup)
MINIO_ROOT_PASSWORD=bidclean_local
# required (validated at startup)
MINIO_ENDPOINT=http://localhost:9000

# --- Keycloak (Auth) ---

# Admin API credentials (used by NestJS to create users, revoke sessions)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_URL=http://localhost:8080

# Realm and client configuration
KEYCLOAK_REALM=bidclean
KEYCLOAK_CLIENT_ID=bidclean-app
KEYCLOAK_CLIENT_SECRET=change_me_in_production

# JWT validation
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/bidclean/protocol/openid-connect/certs

# OAuth endpoints
KEYCLOAK_TOKEN_ENDPOINT=http://localhost:8080/realms/bidclean/protocol/openid-connect/token
KEYCLOAK_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/bidclean/protocol/openid-connect/auth

# OAuth callback (where Keycloak redirects after login on web/API)
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# Mobile OAuth configuration (deep link scheme for PKCE redirect)
KEYCLOAK_MOBILE_REDIRECT_SCHEME=bidclean
KEYCLOAK_MOBILE_REDIRECT_URI=bidclean://auth/callback

# Email verification sync (Keycloak → BidClean DB)
KEYCLOAK_EMAIL_SYNC_INTERVAL_MS=30000
KEYCLOAK_EMAIL_SYNC_BATCH_SIZE=50

# --- Stripe ---
# required (validated at startup)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# required (validated at startup)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Payments (Stripe Escrow) ---

# Stripe config (pinned API version; Connect uses Express accounts)
STRIPE_API_VERSION=2024-06-20
# required (validated at startup)
STRIPE_CONNECT_ACCOUNT_TYPE=express

# Webhook replay guard: reject events older than this window (seconds)
# required (validated at startup)
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Express onboarding Account Link URLs (Stripe redirects the Cleaner here)
# required (validated at startup)
STRIPE_ONBOARDING_REFRESH_URL=https://app.bidclean.tech/payments/onboarding/refresh
# required (validated at startup)
STRIPE_ONBOARDING_RETURN_URL=https://app.bidclean.tech/payments/onboarding/return

# Escrow auto-release: hours funds are held before releasing to the Cleaner (hours)
# required (validated at startup)
ESCROW_AUTO_RELEASE_HOURS=24

# Background sweep intervals (milliseconds)
# required (validated at startup)
PAYMENTS_AUTO_RELEASE_SWEEP_MS=300000
# required (validated at startup)
PAYMENTS_RECONCILE_INTERVAL_MS=600000
# required (validated at startup)
CONNECT_RECONCILE_INTERVAL_MS=900000

# Max disputes to scan per charge during the dispute reconciliation sweep
# required (validated at startup)
STRIPE_DISPUTE_LIST_LIMIT=10

# BullMQ job retry configuration (count / milliseconds)
# required (validated at startup)
PAYMENTS_MAX_RETRIES=5
# required (validated at startup)
PAYMENTS_BACKOFF_DELAY_MS=5000

# --- RevenueCat ---
# Server secret REST key + base URL. SHARED across the account-deletion cascade
# (user-profile) and the subscriptions module (revenuecat-subscriptions). Do NOT duplicate.
# required (validated at startup)
REVENUECAT_API_KEY=sk_...
REVENUECAT_API_URL=https://api.revenuecat.com/v1
REVENUECAT_API_V2_SECRET=sk_...
REVENUECAT_PROJECT_ID=proj_...

# Webhook authentication. At least one secret is REQUIRED (HMAC signing preferred over bearer).
# HMAC-SHA256 over the raw body, with a timestamp-tolerance replay guard (constant-time compare).
# required (validated at startup)
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# required (validated at startup)
REVENUECAT_WEBHOOK_AUTH_SECRET=
# required (validated at startup)
REVENUECAT_WEBHOOK_TOLERANCE_SECONDS=300

# Subscription reconciliation sweep + webhook durability/recovery tuning (ms / counts).
# required (validated at startup)
SUBSCRIPTION_RECONCILE_INTERVAL_MS=900000
# required (validated at startup)
SUBSCRIPTION_STALE_WINDOW_MS=86400000
# required (validated at startup)
SUBSCRIPTION_RECONCILE_BATCH=100
# required (validated at startup)
SUBSCRIPTION_DISPATCH_GRACE_MS=60000
# required (validated at startup)
SUBSCRIPTION_MAX_RETRIES=5
# required (validated at startup)
SUBSCRIPTION_BACKOFF_DELAY_MS=5000

# Logical entitlement key -> configured RevenueCat entitlement identifier (lookup_key).
# REQUIRED in production (no hardcoded fallback; a missing mapping fails startup).
RC_ENTITLEMENT_CLEANER_PRO=cleaner_pro
# required (validated at startup)
RC_ENTITLEMENT_HOST_PRO=host_pro
# required (validated at startup)
RC_ENTITLEMENT_AD_FREE=ad_free

# Mobile public SDK keys (client-side only; NEVER ship the server secret key).
# MVP platforms: iOS (App Store) + Android (Play Store). Amazon Appstore is out of scope.
EXPO_PUBLIC_RC_IOS_KEY=appl_...
EXPO_PUBLIC_RC_ANDROID_KEY=goog_...

# --- Ads (RevenueCat Ads / AdMob) ---
# Mobile-only display ads for the free tier (revenuecat-ads). AdMob serves the creative and pays
# the developer; RevenueCat only tracks ad revenue for unified LTV. Only PUBLIC application/ad-unit
# ids are used client-side — mediation account secrets are NEVER shipped or committed.
# Per-platform AdMob application ids (also injected into the native build via the Expo config plugin).
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-...~...
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-...~...
# Per-platform banner ad unit ids. Left empty in dev → the module uses AdMob's official TEST unit
# ids so no real ads serve. Empty in a PRODUCTION build → ads are DISABLED (never a mock fallback).
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=
# Provider selector (default `admob`; set `mock` only for local/dev without a native build).
EXPO_PUBLIC_ADS_PROVIDER=admob
# Operational UI kill-switch (default true; `false` = no ads, radar unaffected).
# NOT a security control — ad eligibility is always governed by `ad_free` via useAdVisibility.
EXPO_PUBLIC_ADS_ENABLED=true
# Salt for the privacy-scoped ad attribution pseudonym (purpose-separated digest over the
# app_user_id). Client-safe: it only prevents trivial on-device reversal, never a server secret.
# The raw internal user UUID is NEVER sent to the ad network.
EXPO_PUBLIC_AD_ATTRIBUTION_SECRET=

# --- OneSignal ---
ONESIGNAL_APP_ID=...
ONESIGNAL_API_KEY=...
# Public OneSignal app id exposed to the mobile client (NEVER the REST key). Mirrors ONESIGNAL_APP_ID.
EXPO_PUBLIC_ONESIGNAL_APP_ID=...
# HMAC secret used to authenticate the OneSignal webhook over the raw body (server-only).
ONESIGNAL_WEBHOOK_SECRET=...
# Max accepted webhook age in seconds (replay guard for the signed timestamp).
ONESIGNAL_WEBHOOK_TOLERANCE_SECONDS=300

# --- Notifications (push-notifications, Spec 16) ---
# BullMQ delivery retry/backoff for the notification delivery worker.
NOTIFICATIONS_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATIONS_DELIVERY_BACKOFF_MS=5000
# Outbox relay drain cadence + batch size (drains committed <domain>_outbox rows into intents).
NOTIFICATIONS_RELAY_INTERVAL_MS=5000
NOTIFICATIONS_RELAY_BATCH_SIZE=100
# Registry <-> OneSignal reconciliation sweep cadence + batch size.
NOTIFICATIONS_RECONCILE_INTERVAL_MS=900000
NOTIFICATIONS_RECONCILE_BATCH_SIZE=100
# Retention horizon (days) beyond which terminal ledger/outbox rows are hard-pruned.
NOTIFICATIONS_RETENTION_DAYS=90

# --- KYC (Know Your Customer) ---

# AI Service (FastAPI)
# required (validated at startup)
KYC_AI_SERVICE_URL=http://localhost:8000
# required (validated at startup)
AI_SERVICE_AUTH_TOKEN=change_me_in_production

# Verification thresholds (scores 0.0–1.0)
# required (validated at startup)
KYC_OCR_CONFIDENCE_THRESHOLD=0.85
# required (validated at startup)
KYC_FACE_SIMILARITY_THRESHOLD=0.80
# required (validated at startup)
KYC_LIVENESS_THRESHOLD=0.90

# Retry & processing
# required (validated at startup)
KYC_MAX_ATTEMPTS=3
KYC_MAX_RETRY_ATTEMPTS=3
# required (validated at startup)
KYC_PROCESSING_MAX_RETRIES=3
# required (validated at startup)
KYC_PROCESSING_BACKOFF_MS=5000
# required (validated at startup)
KYC_PROCESSING_TIMEOUT_MS=60000

# Storage
# required (validated at startup)
KYC_MINIO_BUCKET=kyc-documents
# required (validated at startup)
KYC_RETENTION_DAYS=90
KYC_CLEANUP_BATCH_SIZE=50
# required (validated at startup)
KYC_MAX_FILE_SIZE_MB=10

# Image quality
KYC_MIN_IMAGE_WIDTH=800
KYC_MIN_IMAGE_HEIGHT=600

# Rate limiting
KYC_RATE_LIMIT_PER_HOUR=10

# Concurrency
KYC_MAX_CONCURRENT=5

# --- Profile ---

# Storage
# required (validated at startup)
MINIO_PROFILE_PHOTOS_BUCKET=profile-photos

# Photo constraints
# required (validated at startup)
PROFILE_PHOTO_MAX_SIZE_MB=5
# required (validated at startup)
PROFILE_PHOTO_MAX_DIMENSION_PX=1024
# required (validated at startup)
PROFILE_PHOTO_URL_EXPIRY_SECONDS=3600

# Portfolio
# required (validated at startup)
PROFILE_MAX_PORTFOLIO_PHOTOS=20

# Upload & rate limiting
PROFILE_UPLOAD_TIMEOUT_MS=30000
PROFILE_RATE_LIMIT_PER_MINUTE=60

# Field validation
PROFILE_NAME_MAX_LENGTH=100
PROFILE_BIO_MAX_LENGTH=500

# Account deletion
PROFILE_DELETE_CONFIRMATION_WORD=DELETE
PROFILE_DELETION_MAX_RETRIES=5

# Profile completeness weights (must sum to 100 per role)
PROFILE_COMPLETENESS_WEIGHTS_HOST=name:25,photo:25,business_name:20,payment_method:15,first_property:15
PROFILE_COMPLETENESS_WEIGHTS_CLEANER=name:15,photo:15,specialties:15,work_zone:15,availability:10,portfolio:10,kyc:10,bio:10

# Keycloak webhook (email sync)
KEYCLOAK_WEBHOOK_SECRET=change_me_in_production

# --- Property Management ---

# Storage
# required (validated at startup)
MINIO_PROPERTY_PHOTOS_BUCKET=property-photos

# Photo constraints
# required (validated at startup)
PROPERTY_PHOTO_MAX_SIZE_MB=10
# required (validated at startup)
PROPERTY_PHOTO_MAX_DIMENSION_PX=2048
# required (validated at startup)
PROPERTY_PHOTO_URL_EXPIRY_SECONDS=3600
# required (validated at startup)
PROPERTY_MAX_PHOTOS=10

# Upload & rate limiting
PROPERTY_UPLOAD_TIMEOUT_MS=60000
PROPERTY_RATE_LIMIT_PER_MINUTE=60

# Field validation limits
PROPERTY_MAX_SQM=10000
PROPERTY_MAX_BEDROOMS=50
PROPERTY_MAX_BATHROOMS=20
PROPERTY_MAX_CHECKLIST_ITEMS=30
PROPERTY_MAX_REQUIREMENTS=20

# Geocoding (Mapbox)
# required (validated at startup)
MAPBOX_ACCESS_TOKEN=pk.ey...
# required (validated at startup)
PROPERTY_GEOCODING_RATE_LIMIT=30

# --- Offer Publishing ---

# Commission rates (basis points: 1 bp = 0.01%)
# These are the DEFAULT rates and the single source of truth shared by offer-publishing
# and commission-system. commission-system uses them as its fallback when no rule matches.
OFFER_HOST_FEE_RATE=1000
OFFER_CLEANER_RATE=300

# Commission System — rule resolution, caching, and admin (commission-system module)
# Ruleset in-memory cache refresh interval (milliseconds)
# required (validated at startup)
COMMISSION_RULES_CACHE_TTL_MS=60000
# Bound on the subscriber-tier lookup before degrading to FREE (milliseconds)
# required (validated at startup)
COMMISSION_TIER_LOOKUP_TIMEOUT_MS=500
# Rate limit for admin commission-rule endpoints (requests per minute)
# required (validated at startup)
COMMISSION_ADMIN_RATE_LIMIT_PER_MINUTE=30
# Business-policy caps per side (basis points), distinct from the technical [0,10000] bound
# required (validated at startup)
COMMISSION_MAX_HOST_RATE_BPS=5000
# required (validated at startup)
COMMISSION_MAX_CLEANER_RATE_BPS=5000
# Redis pub/sub channel for cross-instance commission ruleset cache invalidation
# required (validated at startup)
COMMISSION_CACHE_INVALIDATION_CHANNEL=commission:rules:invalidate
# Comma-separated Keycloak subject ids allowed to administer commission rules (operators)
COMMISSION_ADMIN_KEYCLOAK_IDS=

# Radius expansion configuration (meters / milliseconds)
OFFER_INITIAL_RADIUS=3000
OFFER_EXPANSION_STEP=2000
OFFER_MAX_RADIUS=25000
OFFER_EXPANSION_INTERVAL_MS=300000
OFFER_FINAL_WAIT_MS=600000

# Tier delivery timing (milliseconds)
OFFER_FAVORITES_WINDOW_MS=180000
OFFER_PRO_FREE_DELAY_MS=120000

# Validation bounds (minutes)
OFFER_MIN_LEAD_MINUTES=60
OFFER_MIN_DURATION_MINUTES=30
OFFER_MAX_DURATION_MINUTES=480

# BullMQ job configuration
OFFER_MAX_RETRIES=3
OFFER_BACKOFF_DELAY_MS=5000

# --- Offer Negotiation ---

# Price deviation bounds relative to the offer's base price (basis points: 1 bp = 0.01%)
# required (validated at startup)
NEGOTIATION_MIN_DEVIATION_BPS=2000
# required (validated at startup)
NEGOTIATION_MAX_DEVIATION_BPS=2000

# Proposal response window before a pending proposal expires (milliseconds)
# required (validated at startup)
NEGOTIATION_RESPONSE_WINDOW_MS=900000

# Max proposals allowed per negotiation thread (counts every proposal, incl. terminal)
NEGOTIATION_MAX_PROPOSALS=6

# Background sweep intervals (milliseconds)
NEGOTIATION_EXPIRY_SWEEP_MS=60000
# required (validated at startup)
NEGOTIATION_RECONCILE_INTERVAL_MS=120000

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# --- LibreTranslate ---
LIBRE_TRANSLATE_URL=http://localhost:5000

# --- Centrifugo ---
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=CHANGE_ME_IN_PRODUCTION
# HMAC secret used to sign Centrifugo connection + per-channel subscription tokens.
# Consumed by realtime-chat's /auth/centrifugo/token endpoint. REQUIRED in production (fail-fast).
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION

# --- Realtime Chat (realtime-chat) ---
# Post-match Host<->Cleaner messaging. PostgreSQL is the source of truth; Centrifugo is transport.
# Connection/subscription token lifetime in seconds (bounded expiry; client refreshes on expiry).
# required (validated at startup)
CHAT_CONNECTION_TOKEN_TTL_SECONDS=3600
# Max message body length (chars). Bodies over this are rejected with 400 and never persisted.
# required (validated at startup)
CHAT_MESSAGE_MAX_LENGTH=4000
# Default page size for keyset history (before/after cursors).
# required (validated at startup)
CHAT_HISTORY_PAGE_SIZE=50
# Channel namespace prefix for per-conversation channels: chat:conversation:{id}
# required (validated at startup)
CHAT_CHANNEL_PREFIX=chat:conversation:

# Mobile Centrifugo config (client-side; the hook falls back to these defaults if unset).
EXPO_PUBLIC_CENTRIFUGO_WS_URL=wss://ws.bidclean.tech/connection/websocket
EXPO_PUBLIC_CENTRIFUGO_TOKEN_URL=/auth/centrifugo/token
# Mobile chat tunables (optional; sensible constants used when unset).
EXPO_PUBLIC_CHAT_MESSAGE_MAX_LENGTH=4000
EXPO_PUBLIC_CHAT_HISTORY_PAGE_SIZE=50
EXPO_PUBLIC_CHAT_SEND_TIMEOUT_MS=15000

# --- API ---
PORT=3000
NODE_ENV=development

# --- Default User Settings (used for social login users without explicit country/language) ---
DEFAULT_USER_COUNTRY=US
DEFAULT_USER_LANGUAGE=en

