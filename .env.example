# ==============================================================================
# BidClean — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql://bidclean:bidclean_local@localhost:5432/bidclean
POSTGRES_PASSWORD=bidclean_local

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_DURATION=60
RATE_LIMIT_BIOMETRIC_POINTS=5
RATE_LIMIT_BIOMETRIC_DURATION=60
RATE_LIMIT_GENERAL_POINTS=30
RATE_LIMIT_GENERAL_DURATION=60

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=bidclean
MINIO_ROOT_PASSWORD=bidclean_local
MINIO_ENDPOINT=http://localhost:9000

# --- Keycloak (Auth) ---

# Admin API credentials (used by NestJS to create users, revoke sessions)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_URL=http://localhost:8080

# Realm and client configuration
KEYCLOAK_REALM=bidclean
KEYCLOAK_CLIENT_ID=bidclean-app
KEYCLOAK_CLIENT_SECRET=change_me_in_production

# JWT validation
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/bidclean/protocol/openid-connect/certs

# OAuth endpoints
KEYCLOAK_TOKEN_ENDPOINT=http://localhost:8080/realms/bidclean/protocol/openid-connect/token
KEYCLOAK_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/bidclean/protocol/openid-connect/auth

# OAuth callback (where Keycloak redirects after login on web/API)
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# Mobile OAuth configuration (deep link scheme for PKCE redirect)
KEYCLOAK_MOBILE_REDIRECT_SCHEME=bidclean
KEYCLOAK_MOBILE_REDIRECT_URI=bidclean://auth/callback

# Email verification sync (Keycloak → BidClean DB)
KEYCLOAK_EMAIL_SYNC_INTERVAL_MS=30000
KEYCLOAK_EMAIL_SYNC_BATCH_SIZE=50

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- RevenueCat ---
REVENUECAT_API_KEY_APPLE=appl_...
REVENUECAT_API_KEY_GOOGLE=goog_...
REVENUECAT_API_V2_SECRET=sk_...

# --- OneSignal ---
ONESIGNAL_APP_ID=...
ONESIGNAL_API_KEY=...

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=pk.ey...

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# --- LibreTranslate ---
LIBRE_TRANSLATE_URL=http://localhost:5000

# --- Centrifugo ---
CENTRIFUGO_API_KEY=CHANGE_ME_IN_PRODUCTION
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION

# --- API ---
PORT=3000
NODE_ENV=development

# --- Default User Settings (used for social login users without explicit country/language) ---
DEFAULT_USER_COUNTRY=US
DEFAULT_USER_LANGUAGE=en
