DISPUTE_EVIDENCE_MAX_SIZE_BYTES=10485760
DISPUTE_EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
DISPUTE_EVIDENCE_MAX_PER_DISPUTE=10
DISPUTE_EVIDENCE_UPLOAD_URL_TTL_SECONDS=300
DISPUTE_EVIDENCE_PLAYBACK_URL_TTL_SECONDS=300
DISPUTE_EVIDENCE_UPLOAD_GRANT_TTL_SECONDS=600
DISPUTE_EVIDENCE_RETENTION_DAYS=90
DISPUTE_EVIDENCE_RETENTION_AUDIT_BUFFER_MS=2592000000
DISPUTE_SLA_SWEEP_INTERVAL_MS=60000
DISPUTE_SLA_SWEEP_BATCH_SIZE=100
DISPUTE_INTENT_DRAIN_INTERVAL_MS=15000
DISPUTE_INTENT_DRAIN_BATCH_SIZE=100
DISPUTE_INTENT_LEASE_MS=60000
DISPUTE_CREATION_DRAIN_INTERVAL_MS=15000
DISPUTE_CREATION_DRAIN_BATCH_SIZE=100
DISPUTE_CLEANUP_INTERVAL_MS=3600000
DISPUTE_CLEANUP_BATCH_SIZE=100
DISPUTE_STALE_GRANT_INTERVAL_MS=600000
DISPUTE_STALE_GRANT_BATCH_SIZE=100
