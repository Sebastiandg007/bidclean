# --- Voice Notes (voice-notes, Spec 14) ---
# A voice note is a chat_messages row with type='VOICE'; audio bytes live in MinIO (never in
# PostgreSQL, never through the API), reached via short-lived participant-gated pre-signed URLs.
# Transcription (Whisper.cpp in the AI service) is asynchronous, best-effort, and never blocks
# send or playback. All values below feed validateVoiceNotesConfig() (fail-fast, skipped in tests).
# Reuses MINIO_ENDPOINT / MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (declared above), REDIS_URL (BullMQ),
# and AI_SERVICE_AUTH_TOKEN (declared under KYC) for service-to-service auth to the AI /speech API.

# Dedicated MinIO bucket for voice-note audio (private, no public read).
# required (validated at startup)
MINIO_VOICE_NOTES_BUCKET=chat-voice-notes
# Maximum clip duration in milliseconds (server-authoritative; declared duration is advisory).
# required (validated at startup)
VOICE_MAX_DURATION_MS=120000
# Maximum audio object size in bytes (server-observed size is authoritative).
# required (validated at startup)
VOICE_MAX_SIZE_BYTES=5242880
# Comma-separated allowed audio MIME types (server-observed content type is authoritative).
# required (validated at startup)
VOICE_ALLOWED_MIME_TYPES=audio/mp4,audio/aac,audio/mpeg,audio/ogg,audio/webm,audio/wav
# Pre-signed PUT (upload) URL TTL in seconds (short-lived, single object).
# required (validated at startup)
VOICE_UPLOAD_URL_TTL_SECONDS=300
# Pre-signed GET (playback) URL TTL in seconds (short-lived, participant-gated).
# required (validated at startup)
VOICE_PLAYBACK_URL_TTL_SECONDS=300
# Upload-grant TTL in seconds (binds an object_key to conversation+user, single-use).
# required (validated at startup)
VOICE_UPLOAD_GRANT_TTL_SECONDS=600
# Whether asynchronous transcription is enabled. When false, notes still send/play; status=DISABLED.
VOICE_TRANSCRIPTION_ENABLED=true
# Transcription HTTP timeout to the AI service (milliseconds).
# required (validated at startup)
VOICE_TRANSCRIPTION_TIMEOUT_MS=60000
# Bounded transcription retries (BullMQ attempts + stuck-PENDING sweep re-enqueue bound).
# required (validated at startup)
VOICE_TRANSCRIPTION_MAX_RETRIES=3
# AI/FastAPI base URL for the Whisper /speech/transcribe endpoint (Option A: bytes, no storage ref).
# required (validated at startup when VOICE_TRANSCRIPTION_ENABLED=true)
VOICE_AI_SERVICE_URL=http://localhost:8000
# Cleanup/reconciliation sweep interval (milliseconds) for orphan grants/objects.
# required (validated at startup)
VOICE_CLEANUP_INTERVAL_MS=300000
# Cleanup batch size per sweep pass (bounded, idempotent).
# required (validated at startup)
VOICE_CLEANUP_BATCH_SIZE=100
# Re-enqueue a PENDING transcript older than this (milliseconds) — no PENDING-forever.
# required (validated at startup)
VOICE_TRANSCRIPTION_STUCK_THRESHOLD_MS=600000
# Reconciler ignores bucket objects newer than this grace window (milliseconds).
# required (validated at startup)
VOICE_ORPHAN_RECONCILE_GRACE_MS=3600000

# Mobile voice-note tunable (client-side UX pre-check only; backend/storage limits are authoritative).
EXPO_PUBLIC_VOICE_MAX_DURATION_MS=120000

# --- VoIP Calls (voip-calls, Spec 15) ---
# LiveKit is the live-media transport (self-hosted SFU for WebRTC audio/video). Its credentials
# live ONLY in server configuration and NEVER reach the client except as a short-lived, room-scoped
# access token minted per call. Call control (invite/accept/decline/cancel/end/busy) is signaled
# over the EXISTING chat:conversation:{id} Centrifugo channel; media never transits the API/PostgreSQL.
# validateVoipConfig() fails fast on any missing/invalid required value (skipped under NODE_ENV=test).

# LiveKit server URL the mobile client connects to for media (wss://). Also returned inside the
# minted token payload so the client never hardcodes it.
# required (validated at startup)
LIVEKIT_URL=wss://rtc.bidclean.tech
# LiveKit API key — signs access tokens (server-side only, never shipped to the client).
# required (validated at startup)
LIVEKIT_API_KEY=CHANGE_ME_IN_PRODUCTION
# LiveKit API secret — signs access tokens (server-side only, never shipped to the client).
# required (validated at startup)
LIVEKIT_API_SECRET=CHANGE_ME_IN_PRODUCTION
# LiveKit webhook signing key/secret — authenticates the signed LiveKit webhook over the raw body
# (server-authoritative liveness). Defaults to the API key/secret when LiveKit is configured to
# sign webhooks with the API credentials; override only if you use a dedicated webhook key pair.
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=
# Media (LiveKit access) token TTL in seconds — short-lived, room-scoped, identity-scoped.
# required (validated at startup)
VOIP_MEDIA_TOKEN_TTL_SECONDS=300
# Ring window in milliseconds — an unanswered RINGING call past this becomes MISSED via the sweep.
# required (validated at startup)
VOIP_RING_TIMEOUT_MS=45000
# Stale-call window in milliseconds — an ONGOING call whose LiveKit-webhook-driven media activity
# is older than this is force-ended (ENDED/TIMEOUT) by the sweep.
# required (validated at startup)
VOIP_STALE_CALL_TIMEOUT_MS=90000
# Coarse backstop: max call duration in milliseconds — an ONGOING call answered longer ago than
# this is force-ended (ENDED/TIMEOUT) even if media activity looks fresh.
# required (validated at startup)
VOIP_MAX_CALL_DURATION_MS=14400000
# Whether video calling is enabled. When false, calls are audio-only regardless of requested kind.
VOIP_VIDEO_ENABLED=true
# Sweep interval in milliseconds (ring-timeout + stale-call passes).
# required (validated at startup)
VOIP_SWEEP_INTERVAL_MS=15000
# Sweep batch size per pass (bounded, idempotent).
# required (validated at startup)
VOIP_SWEEP_BATCH_SIZE=100

# Mobile LiveKit URL (client reads it from EXPO_PUBLIC_* or from the minted token payload; never a
# hardcoded literal or embedded credential).
EXPO_PUBLIC_LIVEKIT_URL=wss://rtc.bidclean.tech

# ─────────────────────────────────────────────────────────────────────────────
# Service Tracking (service-tracking, Spec 17)
# ─────────────────────────────────────────────────────────────────────────────
# The post-match, pre-work phase: the Cleaner heads to the property, the Host watches the live
# position on a map, and a SERVER-AUTHORITATIVE geofence confirms arrival. Position ingress is
# Option A (the Cleaner POSTs to the backend; the server evaluates then re-publishes to the Host —
# the Cleaner never publishes to the channel). Live position is EPHEMERAL (never persisted); the
# only durable location datum is arrival_distance_m. CENTRIFUGO_TOKEN_SECRET / CENTRIFUGO_API_URL /
# CENTRIFUGO_API_KEY (above) are REUSED for the session channel token + publishing.
# All required values are validated at startup (validateServiceTrackingConfig, fail-fast).

# Geofence radius (metres) snapshotted onto a session at creation (default ~50m).
SERVICE_GEOFENCE_RADIUS_M=50

# Server-side rate limit: min interval (ms) between accepted position samples per (user, session).
# The server NEVER trusts the client to self-limit; over-frequent samples are ignored (not errored).
SERVICE_POSITION_MIN_INTERVAL_MS=3000

# Eligibility gate: max reported accuracy (metres). A worse-accuracy sample is ineligible for
# arrival (accuracy is a gate ONLY — never used to widen/narrow/correct the geofence radius).
SERVICE_POSITION_MAX_ACCURACY_M=50

# Eligibility gate: max sample age (ms), i.e. (server_now - at). An older sample is ineligible.
SERVICE_POSITION_MAX_AGE_MS=30000

# Eligibility gate: max tolerated future-dating (ms). A sample with at > server_now + this is
# ineligible (rejects future-dated samples).
SERVICE_POSITION_MAX_CLOCK_SKEW_MS=5000

# Channel namespace prefix for per-session channels: service:session:{id}.
SERVICE_POSITION_CHANNEL_PREFIX=service:session:

# Session channel subscription token TTL (seconds) — bounded expiry.
SERVICE_POSITION_TOKEN_TTL_SECONDS=3600

# Stale window (ms): an EN_ROUTE session with no eligible progress within this is force-expired
# (EXPIRED_NO_PROGRESS) by the sweep.
SERVICE_EN_ROUTE_STALE_MS=1800000

# Abandon window (ms): a session that never leaves MATCHED within this is force-expired
# (EXPIRED_NEVER_STARTED) by the sweep.
SERVICE_SESSION_ABANDON_MS=3600000

# Sweep interval (ms) between repeatable force-expiry passes.
SERVICE_SWEEP_INTERVAL_MS=60000

# Sweep batch size per pass (bounded, idempotent).
SERVICE_SWEEP_BATCH_SIZE=100

# Activation-consumer (service_activation_ready) drain tuning.
SERVICE_ACTIVATION_DRAIN_BATCH_SIZE=100
SERVICE_ACTIVATION_DRAIN_INTERVAL_MS=5000

# Mobile client-side position send cadence (ms). The server INDEPENDENTLY rate-limits (above) —
# never trusting the client to self-limit.
EXPO_PUBLIC_SERVICE_POSITION_MIN_INTERVAL_MS=3000

# ── Video Verification (Spec 18) — on-arrival identity check ──────────────────
VIDEO_VERIFICATION_ENABLED=true
VIDEO_VERIFICATION_MINIO_BUCKET=verification-videos
VIDEO_VERIFICATION_MAX_SIZE_BYTES=15728640
VIDEO_VERIFICATION_MAX_DURATION_MS=15000
VIDEO_VERIFICATION_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm
VIDEO_VERIFICATION_UPLOAD_URL_TTL_SECONDS=300
VIDEO_VERIFICATION_UPLOAD_GRANT_TTL_SECONDS=600
VIDEO_VERIFICATION_MATCH_THRESHOLD=0.6
VIDEO_VERIFICATION_AI_URL=http://ai:8000
VIDEO_VERIFICATION_TIMEOUT_MS=60000
VIDEO_VERIFICATION_MAX_RETRIES=3
VIDEO_VERIFICATION_RETENTION_HOURS=48
VIDEO_VERIFICATION_UPLOAD_WINDOW_MS=900000
VIDEO_VERIFICATION_STUCK_THRESHOLD_MS=600000
VIDEO_VERIFICATION_SWEEP_INTERVAL_MS=300000
VIDEO_VERIFICATION_SWEEP_BATCH_SIZE=100
VIDEO_VERIFICATION_CLEANUP_INTERVAL_MS=300000
VIDEO_VERIFICATION_CLEANUP_BATCH_SIZE=100
VIDEO_VERIFICATION_ARRIVAL_DRAIN_BATCH_SIZE=100
VIDEO_VERIFICATION_ARRIVAL_DRAIN_INTERVAL_MS=5000
VIDEO_VERIFICATION_BACKOFF_DELAY_MS=5000
# AI service (services/ai) — no MinIO credentials (Option A)
VIDEO_VERIFICATION_SIMILARITY_THRESHOLD=0.6
VIDEO_VERIFICATION_MAX_FILE_SIZE_MB=20
# Mobile (public UX pre-check only)
EXPO_PUBLIC_VIDEO_VERIFICATION_MAX_DURATION_MS=15000

# ── checklist-photos (Spec 19) — in-progress checklist + evidence photos ──────
CHECKLIST_PHOTO_MINIO_BUCKET=checklist-photos
CHECKLIST_PHOTO_MAX_SIZE_BYTES=10485760
CHECKLIST_PHOTO_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic
CHECKLIST_PHOTO_MAX_PER_TASK=5
CHECKLIST_PHOTO_UPLOAD_URL_TTL_SECONDS=300
CHECKLIST_PHOTO_PLAYBACK_URL_TTL_SECONDS=300
CHECKLIST_PHOTO_UPLOAD_GRANT_TTL_SECONDS=600
CHECKLIST_PHOTO_RETENTION_DAYS=90
# Task-level photo policy: NONE | ALL_TASKS  ·  Run completion: NONE | ALL_TASKS_DONE | ALL_REQUIRED_PHOTOS
CHECKLIST_PHOTO_REQUIRED_POLICY=NONE
CHECKLIST_COMPLETION_PRECONDITION=NONE
CHECKLIST_SWEEP_INTERVAL_MS=60000
CHECKLIST_SWEEP_BATCH_SIZE=100
CHECKLIST_CLEANUP_INTERVAL_MS=300000
CHECKLIST_CLEANUP_BATCH_SIZE=100
CHECKLIST_STALE_GRANT_INTERVAL_MS=300000
CHECKLIST_STALE_GRANT_BATCH_SIZE=100
CHECKLIST_STARTED_DRAIN_BATCH_SIZE=100
CHECKLIST_STARTED_DRAIN_INTERVAL_MS=5000
CHECKLIST_STUCK_RUN_THRESHOLD_MS=3600000
# Mobile (public UX pre-check only)
EXPO_PUBLIC_CHECKLIST_PHOTO_MAX_SIZE_BYTES=10485760

# ── service-completion (Spec 20) — completion decision + escrow release trigger ──
# Auto-release window (default 24h); snapshotted per completion from the finish time
SERVICE_AUTO_RELEASE_WINDOW_MS=86400000
# Auto-release sweep tuning
SERVICE_COMPLETION_SWEEP_INTERVAL_MS=60000
SERVICE_COMPLETION_SWEEP_BATCH_SIZE=100
# Release-intent drain worker tuning
SERVICE_COMPLETION_RELEASE_INTENT_INTERVAL_MS=15000
SERVICE_COMPLETION_RELEASE_INTENT_BATCH_SIZE=100
# DISPATCHED claim lease (MUST be > the drain interval so a live dispatch is never stolen)
SERVICE_COMPLETION_RELEASE_INTENT_LEASE_MS=60000
# checklist_completed creation-consumer drain tuning
SERVICE_COMPLETION_CREATION_DRAIN_INTERVAL_MS=15000
SERVICE_COMPLETION_CREATION_DRAIN_BATCH_SIZE=100
# Rating bounds (mutual Host<->Cleaner rating; captured, never gating)
SERVICE_RATING_MIN_STARS=1
SERVICE_RATING_MAX_STARS=5

# ── dispute-system (Spec 21) — dispute case + resolution (drives Spec 9, no Stripe keys) ──
DISPUTE_EVIDENCE_WINDOW_MS=172800000
DISPUTE_RESOLUTION_SLA_MS=604800000
DISPUTE_FALLBACK_RESOLUTION=FAVOR_CLEANER
DISPUTE_FALLBACK_PARTIAL_REFUND_CENTS=0
DISPUTE_REASON_CODES=QUALITY_INCOMPLETE,QUALITY_DAMAGE,NOT_AS_DESCRIBED,NO_SHOW,PAYOUT_NOT_RELEASED,WRONGFUL_REFUND
DISPUTE_INITIATION_POLICY=HOST:QUALITY_INCOMPLETE:*,HOST:QUALITY_DAMAGE:*,HOST:NOT_AS_DESCRIBED:*,HOST:NO_SHOW:*,CLEANER:PAYOUT_NOT_RELEASED:*,CLEANER:WRONGFUL_REFUND:*
DISPUTE_RESOLVER_ROLE=operator
