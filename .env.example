# ==============================================================================
# BidClean — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql://bidclean:bidclean_local@localhost:5432/bidclean
POSTGRES_PASSWORD=bidclean_local

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=bidclean
MINIO_ROOT_PASSWORD=bidclean_local
MINIO_ENDPOINT=http://localhost:9000

# --- Keycloak (Auth) ---
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_URL=http://localhost:8080

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- RevenueCat ---
REVENUECAT_API_KEY_APPLE=appl_...
REVENUECAT_API_KEY_GOOGLE=goog_...
REVENUECAT_API_V2_SECRET=sk_...

# --- OneSignal ---
ONESIGNAL_APP_ID=...
ONESIGNAL_API_KEY=...

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=pk.ey...

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# --- LibreTranslate ---
LIBRE_TRANSLATE_URL=http://localhost:5000

# --- Centrifugo ---
CENTRIFUGO_API_KEY=CHANGE_ME_IN_PRODUCTION
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION

# --- API ---
PORT=3000
NODE_ENV=development
